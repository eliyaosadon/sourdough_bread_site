# Copy this file to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/sourdough

# AI advisor (server-side only, never expose these to the browser).
# It works with any OpenAI-compatible provider. Default is Groq's free tier:
#   get a free key at https://console.groq.com (no credit card)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# If you get model_not_found, your account may not have access to that model.
#   List the ones you can use: https://api.groq.com/openai/v1/models (with your key)
# Other free options (change all three values together):
#   OpenRouter:    https://openrouter.ai/api/v1  with a model whose name ends in ":free"
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai  with a gemini model

# Payment provider credentials (added in the checkout phase)
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
